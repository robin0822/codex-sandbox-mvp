#!/usr/bin/env bash
set -euo pipefail

mkdir -p /workspace/repository /results

repository_commit="$(cat /job/repository-commit.txt)"
clone_started_ns="$(date +%s%N)"

# The cache is owned by Manager on the host, while Runner uses a separate UID.
git config --global --add safe.directory /cache/repository.git

git clone \
  --no-local \
  /cache/repository.git \
  /workspace/repository
git -C /workspace/repository checkout --detach "${repository_commit}"
clone_finished_ns="$(date +%s%N)"
printf '%s' "$(( (clone_finished_ns - clone_started_ns) / 1000000 ))" > /results/clone-milliseconds.txt

cd /workspace/repository
set +e

# Each task already runs inside its own Docker container. Nested bubblewrap
# namespaces fail under the default Docker seccomp profile.
codex_started_ns="$(date +%s%N)"
python3 /usr/local/bin/codex-exec-stream.py codex exec \
  --ephemeral \
  --json \
  --sandbox "${CODEX_SANDBOX_MODE:-danger-full-access}" \
  --output-last-message /results/final-message.md \
  - < /job/prompt.txt

codex_exit_code=$?
codex_finished_ns="$(date +%s%N)"
printf '%s' "$(( (codex_finished_ns - codex_started_ns) / 1000000 ))" > /results/codex-milliseconds.txt

git status --porcelain=v1 > /results/git-status.txt
git diff --binary > /results/changes.diff
printf '%s' "${codex_exit_code}" > /results/exit-code.txt

exit "${codex_exit_code}"
